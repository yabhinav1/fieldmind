# FieldMind device settings for a Pterodactyl / HidenCloud server. Edit and save.
# One panel server = one device. Make a second server with FIELDMIND_DEVICE=edge-b.

# This device's name, as shown in the dashboard and to the fleet.
FIELDMIND_DEVICE=edge-a
FIELDMIND_AUTHOR=technician-a
FIELDMIND_SITE=plant-1

# The PIN that unlocks the dashboard. Change it after the first login if you like.
FIELDMIND_PIN=2468

# The cloud: a free Qdrant Cloud cluster (https://cloud.qdrant.io). Paste the
# cluster URL and an API key. Both devices must use the same values.
FIELDMIND_CLOUD_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
FIELDMIND_CLOUD_API_KEY=YOUR-API-KEY

# Optional: the other device's public address, so the two still exchange notes
# directly when the cloud is unreachable. Same token on both servers.
# FIELDMIND_PEERS=http://node.hidencloud.com:PORT-OF-EDGE-B
# FIELDMIND_PEER_TOKEN=change-me

# No language model on a panel server: answers are composed from the notes.
FIELDMIND_OLLAMA_MODEL=

# Photos need 590 MB more of models and a third 215 MB shard; leave off on small plans.
FIELDMIND_PHOTOS=0

# On a server with less than 1 GB of RAM, turn the reranker off to save about 100 MB.
# FIELDMIND_RERANK=0
