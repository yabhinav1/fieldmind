# Copy to .env and edit. Every value is optional.

# The cloud every device syncs with. Default is the Qdrant Server in docker-compose.yml.
# For Qdrant Cloud, use your cluster URL and an API key.
# FIELDMIND_CLOUD_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
# FIELDMIND_CLOUD_API_KEY=your-api-key

# For a second laptop on the same network, point at the first laptop instead:
# FIELDMIND_CLOUD_URL=http://192.168.1.20:6333

# Pre-set the device PIN. Without it, the first person to open the dashboard on the
# device chooses one. A PIN changed in the dashboard later is kept.
# FIELDMIND_PIN=2468

# On-device language model for answers. Empty model means answers are composed from notes.
# FIELDMIND_OLLAMA_URL=http://127.0.0.1:11435
# FIELDMIND_OLLAMA_MODEL=llama3.2:3b

# Devices only download memories from their own site, plus fleet-wide knowledge.
# FIELDMIND_SITE=plant-1

# Other devices on the same network, consulted when the cloud is out of reach.
# All devices in a fleet share one token (any string).
# FIELDMIND_PEERS=http://192.168.1.21:8001,http://192.168.1.22:8001
# FIELDMIND_PEER_TOKEN=change-me

# Photos as memories (downloads a 590 MB CLIP model pair on first start).
# FIELDMIND_PHOTOS=1

# Embedding model: "english" (default, 130 MB) or "multilingual" (220 MB), which
# understands notes in Hindi and other Indian and European languages. Every device
# in a fleet must use the same one; change it before the first start.
# FIELDMIND_EMBED_MODEL=multilingual

# Speech to text on the device (Whisper base, 140 MB) so dictation works in every
# browser and offline. "tiny"/"base"/"small" picks the size; 0 turns it off.
# FIELDMIND_SPEECH=base

# Rerank search candidates with a small cross-encoder (23 MB). On by default.
# FIELDMIND_RERANK=1

# Seal private note text, the activity log and photo files on disk with a key in
# the device's data directory. On by default. The key file can live elsewhere.
# FIELDMIND_ENCRYPT=1
# FIELDMIND_KEY_FILE=/secure/fieldmind-edge-a.key

# A change that keeps failing while the cloud is up is set aside after this many
# attempts so the rest of the queue drains. Retry it from the Sync tab.
# FIELDMIND_SYNC_MAX_ATTEMPTS=5

# /metrics (Prometheus format, counts and timings only) is open unless a token is set.
# FIELDMIND_METRICS_TOKEN=change-me
